module

public import DY.Actions.Random
import all DY.Actions.Random
import all DY.Trace.Manipulation
import all DY.Trace.Basic

namespace DY.Random

/-- Equal random values have the same generation timestamp and size. -/
private theorem makeRand_injective
  [BytesFunctor] [BytesFunctor.Has SubF]
  {time₁ size₁ time₂ size₂ : Nat}
  (h : makeRand time₁ size₁ = makeRand time₂ size₂) :
  time₁ = time₂ ∧ size₁ = size₂
:= by
  simp only [makeRand] at h
  grind

/-- The random value was generated by the immediately preceding trace entry. -/
public def JustGenerated
  [BytesFunctor] [BytesFunctor.Has SubF]
  [ExecTraceTypes] [ProofTraceTypes] (value : Bytes) (tr : ProofTrace) :
  Prop
:=
  ∃ time size, value = makeRand time size ∧ tr.length = time + 1

/-- The same random value can be freshly generated only at the same trace length. -/
public theorem JustGenerated.trace_length_eq
  [BytesFunctor] [BytesFunctor.Has SubF]
  [ExecTraceTypes] [ProofTraceTypes] {value : Bytes} {tr₁ tr₂ : ProofTrace}
  (h₁ : JustGenerated value tr₁) (h₂ : JustGenerated value tr₂) :
  tr₁.length = tr₂.length
:= by
  obtain ⟨time₁, size₁, hv₁, hl₁⟩ := h₁
  obtain ⟨time₂, size₂, hv₂, hl₂⟩ := h₂
  have heq := makeRand_injective (hv₁.symm.trans hv₂)
  grind

/-- Random generation establishes its invariant, label, usage, and freshness. -/
public theorem genRand.fresh_spec
  [BytesFunctor] [BytesFunctor.Has SubF]
  [ExecTraceTypes] [ProofTraceTypes] [TraceInvariant]
  [BytesInvariants] [BytesInvariantsProofs]
  [ExecTraceTypes.Has ExecEntryT] [ProofTraceTypes.Has ProofEntryT] [TraceInvariant.Has ProofEntryT]
  [BytesInvariants.Has invariants]
  (size : Nat) (label : Bytes → Label) (usage : Usage) :
  HoareTripleGhost (genRand size) (label, usage)
    (fun _ => True)
    (fun value tr =>
      value.Invariant tr ∧ value.label tr = label value ∧
      value.HasUsage usage tr ∧ JustGenerated value tr)
:= by
  constructor
  simp only [hoareTriple, wp, genRand, Traceful.run_bind, appendEntry,
    Traceful.run_mk, Traceful.run_pure]
  intro tr _ htr
  refine ⟨tr.append (ProofEntryT.mk size (label (makeRand tr.length size)) usage), ?_⟩
  simp_all [Trace.append_erase, Trace.append_le, Trace.invariant_append,
    Trace.erase_length, JustGenerated, ErasableProofEntry.erase, SubTraceInvariant.invariant]
  have hat := Trace.at?_append tr (ProofEntryT.mk size (label (makeRand tr.length size)) usage)
  simp only [Trace.append, Trace.length] at *
  grind [makeRand.Invariant]

end DY.Random
